# Public web config
NEXT_PUBLIC_CIRCLE_APP_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Optional override (default https://api.circle.com)
# NEXT_PUBLIC_CIRCLE_BASE_URL=

NEXT_PUBLIC_FACEBOOK_APP_ID=
# Marketing / product site (main menu link). Defaults to https://arc.network if unset.
NEXT_PUBLIC_PRODUCT_SITE_URL=

# Arc chain relayer config
RPC_URL=https://rpc.testnet.arc.network
# Circle server API (never expose to the browser)
CIRCLE_API_KEY=
PRIVATE_KEY=
CONTRACT_ADDRESS=
USDC_CONTRACT_ADDRESS=0x3600000000000000000000000000000000000000

# API runtime tuning
CLAIM_RATE_LIMIT_PER_MINUTE=12
CLAIM_AUDIT_LOG_PATH=.logs/claim-audit.log
SENDER_GIFT_LOG_PATH=.logs/sender-gifts.log
ADMIN_AUDIT_LOG_PATH=.logs/admin-audit.log
PRODUCT_ANALYTICS_LOG_PATH=.logs/product-analytics.log
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_COOLDOWN_MINUTES=30
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin dashboard
ADMIN_DASHBOARD_PASSWORD=
ADMIN_SESSION_SECRET=
